{
  "info": {
    "name": "Mini Booking Service",
    "description": "REST API pemesanan kursi bus dengan seat lock 5 menit dan autentikasi JWT. Jalankan request 'Login' terlebih dahulu; token otomatis tersimpan ke variabel collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001/api" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "scheduleId", "value": "1" },
    { "key": "seatId", "value": "1" },
    { "key": "date", "value": "2026-10-15" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', j.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', j.refreshToken);",
                  "}",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"budi\",\n  \"password\": \"password123\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', j.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', j.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth", "refresh"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] }
          }
        }
      ]
    },
    {
      "name": "Jadwal & Kursi (Publik)",
      "item": [
        {
          "name": "Daftar Rute",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/routes", "host": ["{{baseUrl}}"], "path": ["routes"] }
          }
        },
        {
          "name": "Cari Jadwal",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/schedules?origin=Bandung&destination=Jakarta&date={{date}}",
              "host": ["{{baseUrl}}"],
              "path": ["schedules"],
              "query": [
                { "key": "origin", "value": "Bandung" },
                { "key": "destination", "value": "Jakarta" },
                { "key": "date", "value": "{{date}}" }
              ]
            }
          }
        },
        {
          "name": "Detail Jadwal",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/schedules/{{scheduleId}}", "host": ["{{baseUrl}}"], "path": ["schedules", "{{scheduleId}}"] }
          }
        },
        {
          "name": "Ketersediaan Kursi",
          "request": {
            "method": "GET",
            "description": "Token opsional. Jika dikirim, kursi milik sendiri ditandai lockedByMe: true.",
            "url": { "raw": "{{baseUrl}}/schedules/{{scheduleId}}/seats", "host": ["{{baseUrl}}"], "path": ["schedules", "{{scheduleId}}", "seats"] }
          }
        }
      ]
    },
    {
      "name": "Lock & Booking (Terproteksi)",
      "item": [
        {
          "name": "Kunci Kursi",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"scheduleId\": {{scheduleId}},\n  \"seatIds\": [{{seatId}}]\n}" },
            "url": { "raw": "{{baseUrl}}/locks", "host": ["{{baseUrl}}"], "path": ["locks"] }
          }
        },
        {
          "name": "Lepas Lock",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"seatIds\": [{{seatId}}]\n}" },
            "url": { "raw": "{{baseUrl}}/locks", "host": ["{{baseUrl}}"], "path": ["locks"] }
          }
        },
        {
          "name": "Konfirmasi Booking",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"scheduleId\": {{scheduleId}},\n  \"seatIds\": [{{seatId}}]\n}" },
            "url": { "raw": "{{baseUrl}}/bookings", "host": ["{{baseUrl}}"], "path": ["bookings"] }
          }
        },
        {
          "name": "Riwayat Booking Saya",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/bookings/me", "host": ["{{baseUrl}}"], "path": ["bookings", "me"] }
          }
        },
        {
          "name": "Kunci Kursi Tanpa Token (harus 401)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"scheduleId\": {{scheduleId}},\n  \"seatIds\": [{{seatId}}]\n}" },
            "url": { "raw": "{{baseUrl}}/locks", "host": ["{{baseUrl}}"], "path": ["locks"] }
          }
        }
      ]
    }
  ]
}
